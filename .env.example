# Titan SMTP / Vercel Environment Variables
# Vercel > Project > Settings > Environment Variables alanına girin.

SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@guvenismakine.com
SMTP_PASS=BURAYA_TITAN_MAIL_SIFRESI

MAIL_FROM=info@guvenismakine.com
MAIL_FROM_NAME=Güven Web Sitesi
MAIL_TO=info@guvenismakine.com

# Not: Vercel'e girerken değerleri tırnaksız yazın.
# SMTP_PASS alanına Titan webmail giriş şifresini yazın.
