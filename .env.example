# RESEND MAIL KURULUMU
# Vercel > Project > Settings > Environment Variables alanına aşağıdakileri ekleyin.
# Değerleri ekledikten sonra mutlaka Redeploy yapın.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend içinde doğrulanmış domain üzerinden gönderici.
# guvenismakine.com domaini Resend'de doğrulandıktan sonra bu adres çalışır.
RESEND_FROM=Güven Web Sitesi <noreply@guvenismakine.com>

# Formların düşeceği alıcı adresi.
MAIL_TO=info@guvenismakine.com
