# ÜCRETSİZ FORM / MAIL YÖNTEMİ
# Bu sürüm Titan SMTP kullanmaz. Böylece SMTP şifresi, port ve 2FA sorunları ortadan kalkar.

# Varsayılan alıcı mail adresi:
MAIL_TO=info@guvenismakine.com

# Varsayılan ücretsiz yöntem FormSubmit'tir. Ek SMTP şifresi gerekmez.
CONTACT_PROVIDER=formsubmit

# ÖNEMLİ:
# FormSubmit ilk kullanımda info@guvenismakine.com adresine aktivasyon/onay maili gönderebilir.
# Formu bir kez test edin, gelen aktivasyon mailindeki onay bağlantısına tıklayın.
# Sonrasında teklif ve iletişim formları direkt info@guvenismakine.com adresine düşer.

# Daha kontrollü ücretsiz alternatif isterseniz Web3Forms kullanabilirsiniz:
# 1) https://web3forms.com üzerinden info@guvenismakine.com için ücretsiz access key alın.
# 2) Vercel Environment Variables alanına aşağıdaki değeri ekleyin.
# 3) CONTACT_PROVIDER değerini web3forms yapın.
#
# CONTACT_PROVIDER=web3forms
# WEB3FORMS_ACCESS_KEY=BURAYA_WEB3FORMS_ACCESS_KEY
